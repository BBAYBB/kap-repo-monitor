# Bu dosyayı .env adıyla KOPYALAYIN ve kendi bilgilerinizle doldurun.
# .env dosyası .gitignore'dadır; asla paylaşmayın.

# SMTP sunucu ayarları
# Gmail örneği: smtp.gmail.com / 587 (uygulama şifresi gerekir, aşağıya bakın)
# Outlook/Hotmail örneği: smtp-mail.outlook.com / 587
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# SMTP oturum bilgileri
# Gmail kullanıyorsanız normal şifreniz ÇALIŞMAZ; Google Hesabı > Güvenlik >
# 2 Adımlı Doğrulama > Uygulama Şifreleri bölümünden 16 haneli uygulama
# şifresi oluşturup onu girin.
SMTP_USERNAME=ornek@gmail.com
SMTP_PASSWORD=uygulama_sifresi

# Gönderen ve alıcı adres(ler)i. Birden fazla alıcı virgülle ayrılır.
EMAIL_FROM=ornek@gmail.com
EMAIL_TO=barannbay@hotmail.com
